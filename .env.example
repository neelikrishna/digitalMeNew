# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Database (local PostgreSQL install; Docker is optional and not required) ---
# Tables live in their own schema inside the existing `postgres` database.
# Flyway creates the schema on first run, so no manual setup is needed.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_SCHEMA=digitalself
DB_USER=postgres
DB_PASSWORD=

# --- Auth ---
# Generate a strong random secret yourself (256+ bits).
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
JWT_SECRET=

# --- File encryption ---
# Base64-encoded 32 bytes, required for file uploads.
# PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
#
# LOSING THIS KEY MEANS LOSING EVERY ENCRYPTED FILE PERMANENTLY. There is no
# recovery path, by design. Back it up somewhere separate from your backups.
DIGITALSELF_MASTER_KEY=
FILE_STORAGE_PATH=./data/files

# --- Ollama (local install) ---
OLLAMA_BASE_URL=http://localhost:11434
# Must be a model you have actually pulled (check with: ollama list)
OLLAMA_CHAT_MODEL=llama3.2:1b
# Requires `ollama pull nomic-embed-text`. Without it, semantic search is
# unavailable and retrieval falls back to full-text search only.
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Server ---
SERVER_PORT=8443

# --- Optional ---
# Set once the pgvector extension is installed on the Postgres server, to enable
# the embeddings table and semantic search:
# SPRING_PROFILES_ACTIVE=pgvector
